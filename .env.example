# このファイルを .env という名前でコピーし、値を設定してください（.env はGitHubに上げない）
# exe で実行する場合は、Get_RecipeInfo_from_ClaudeCode.exe と同じフォルダに .env を置きます
# パスは ' で囲みます（" で囲むと \t などが特殊文字として読まれ、フォルダ名が変わることがあります）

# レシピフォルダ（料理名のフォルダを置くフォルダ）。楽天レシピ自動投稿の base_folder_path と同じ場所
RECIPE_FOLDER = 'C:\Users\...\Rakutenreshipi_Automation_Edge\投稿素材'

# （任意）claude.exe の場所。未指定なら PATH と %USERPROFILE%\.local\bin\claude.exe から探す
CLAUDE_PATH = ''

# （任意）使うモデル（例: sonnet / opus）。未指定なら Claude Code の既定のモデル
CLAUDE_MODEL = ""

# （任意）1レシピあたりの待ち時間の上限（秒）。未指定なら300
CLAUDE_TIMEOUT = "300"

# （任意）ログの保存先。未指定ならプログラムのフォルダの logs
LOG_DIR = ''
